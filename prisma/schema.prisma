// فكرة — Prisma schema
// Dev uses SQLite (no server needed). For production, switch `provider` to
// "postgresql" and update DATABASE_URL — the models below are portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Application roles. Enforced per-feature in the authorization layer.
/// Stored as a string because SQLite has no native enum type.
enum Role {
  MEMBER
  EVALUATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(MEMBER)
  status       UserStatus @default(ACTIVE)
  jobTitle     String?
  department   String?
  bio          String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  passwordResetTokens PasswordResetToken[]
  ideas               Idea[]
}

/// Backing store for the password-reset flow.
/// NOTE: token delivery by email is NOT connected in Phase 1 — the token is
/// generated and stored, but no email is actually sent.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

/// Full idea lifecycle. Only DRAFT and SUBMITTED are reachable in Phase 2
/// (Idea Submission); the remaining states are introduced with the workflow,
/// evaluation and approval features. Kept here so the type is stable.
enum IdeaStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  EVALUATION
  SHORTLISTED
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  ARCHIVED
}

/// Author's rough estimate of an idea's impact.
enum EstimatedImpact {
  LOW
  MEDIUM
  HIGH
}

/// Idea categories. Bilingual labels so the UI stays fully Arabic/English.
model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  nameEn   String
  nameAr   String
  isActive Boolean @default(true)
  sortOrder Int    @default(0)

  ideas Idea[]
}

/// Free-form tags, reused across ideas (many-to-many).
model Tag {
  id    String @id @default(cuid())
  name  String @unique
  ideas Idea[]
}

/// The core entity of the platform.
model Idea {
  id String @id @default(cuid())

  title       String
  description String

  // Structured, optional detail fields (from the submission form).
  businessProblem  String?
  proposedSolution String?
  expectedBenefits String?
  supportingInfo   String?
  estimatedImpact  EstimatedImpact?

  status      IdeaStatus @default(DRAFT)
  submittedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([status])
}
