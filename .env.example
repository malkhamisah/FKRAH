# Copy this file to `.env` and fill in real values.

# Database connection.
# Development (default): SQLite file, no server required.
DATABASE_URL="file:./dev.db"
# Production example (PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/fkrah?schema=public"

# Secret used to sign session tokens. Generate a strong random value, e.g.:
#   openssl rand -base64 32
AUTH_SECRET="change-me"
